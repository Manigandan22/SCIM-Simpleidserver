{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information",
      "Scim.PubNubWorker": "Trace"
    }
  },

  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },

  "PubNub": {
    "ChannelPatterns": [ "contact.*", "agent.*" ],
    "EventProcessorCount": 2
  },

  "NiceApi": {
    "MaxRetryAttempts": 1,
    "CircuitBreakerDurationSeconds": 10
  },

  "RedisPresence": {
    "ContactTtlSeconds": 5
  }
}
