{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Scim.PubNubWorker": "Debug"
    }
  },

  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },

  "PubNub": {
    "SubscribeKey": "REPLACE_WITH_PUBNUB_SUBSCRIBE_KEY",
    "PublishKey": "REPLACE_WITH_PUBNUB_PUBLISH_KEY",
    "SecretKey": "",
    "UserId": "scim-pubnub-worker",
    "ChannelPatterns": [ "contact.*" ],
    "HeartbeatInterval": 300,
    "ReconnectMaxRetries": -1,
    "EventQueueCapacity": 10000,
    "EventProcessorCount": 4
  },

  "NiceApi": {
    "BaseUrl": "https://api.nicecxone.com",
    "SignalEndpointTemplate": "/api/v1/contacts/{contactId}/signal",
    "ApiKey": "REPLACE_WITH_NICE_API_KEY",
    "BearerToken": "",
    "TimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "RetryBaseDelaySeconds": 2,
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerDurationSeconds": 30,
    "SignalReason": "AgentPresenceExpired"
  },

  "RedisPresence": {
    "ContactTtlSeconds": 5,
    "KeyPrefix": "presence:contact:",
    "LockPrefix": "lock:presence:contact:",
    "LockTtlSeconds": 60,
    "Database": 0
  }
}
